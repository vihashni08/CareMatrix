# CareMatrix Environment Configuration Example
# Copy this file to .env and insert your real API credentials.

# Google Gemini API key for clinical and risk reasoner LLMs
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model ID (e.g. gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# NCBI E-utilities API credentials for PubMed live retrieval (optional)
# Register at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=your_ncbi_api_key_here
NCBI_CONTACT_EMAIL=your_email@example.com
